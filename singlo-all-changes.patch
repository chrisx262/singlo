+  <a class="nav-item" href="voice-painting.html"><div class="nav-icon">🎨</div>Paint</a>
+  <a class="nav-item" href="waves.html"><div class="nav-icon">🌊</div>Waves</a>
+  <a class="nav-item" href="choir.html"><div class="nav-icon">🔥</div>Choir</a>
+  <a class="nav-item" href="battle.html"><div class="nav-icon">⚔️</div>Battle</a>
+  <a class="nav-item" href="badges.html"><div class="nav-icon">🏅</div>Badges</a>
+</nav>
+
+<script src="js/singlo-core.js"></script>
+<script src="js/coach.js"></script>
+<script src="js/sharecard.js"></script>
+<script>
+/* ============ Part 3: exercises per age group ============
+   Kids match pitch CLASS (any octave); teens/adults match exact notes. */
+const EXERCISES = {
+  kids: [
+    { title:'🦁 Lion note', desc:'Hum the big lion note and hold it!', xp:20, chromaOnly:true,
+      steps:[{ midi:60, holdSec:2, tolCents:75 }] },
+    { title:'🐦 Little bird', desc:'Now a high little bird note — tweet tweet!', xp:20, chromaOnly:true,
+      steps:[{ midi:67, holdSec:2, tolCents:75 }] },
+    { title:'🚒 Siren slide', desc:'Slide your voice up like a siren: low note, then high note!', xp:25, chromaOnly:true,
+      steps:[{ midi:60, holdSec:1.2, tolCents:80 },{ midi:67, holdSec:1.2, tolCents:80 }] },
+  ],
+  teens: [
+    { title:'Steady 5 🔒', desc:'Hold one note dead steady for 5 seconds.', xp:35,
+      steps:[{ midi:62, holdSec:5, tolCents:50 }] },
+    { title:'Interval jump 🪜', desc:'Sing the first note, then jump a major third up.', xp:35,
+      steps:[{ midi:60, holdSec:2, tolCents:50 },{ midi:64, holdSec:2, tolCents:50 }] },
+    { title:'Scale climb 🧗', desc:'Climb 5 notes: C D E F G. Breathe between notes.', xp:45,
+      steps:[60,62,64,65,67].map(m=>({ midi:m, holdSec:1.2, tolCents:55 })) },
+  ],
+  adults: [
+    { title:'Cents sniper 🎯', desc:'Hold A3 within ±20 cents for 3 seconds.', xp:50,
+      steps:[{ midi:57, holdSec:3, tolCents:20 }] },
+    { title:'Octave leap 🦘', desc:'C3 then C4 — clean leap, no scooping.', xp:50,
+      steps:[{ midi:48, holdSec:2, tolCents:30 },{ midi:60, holdSec:2, tolCents:30 }] },
+    { title:'Long sustain 🌬️', desc:'10-second sustain. Watch drift at the end of the breath.', xp:60,
+      steps:[{ midi:55, holdSec:10, tolCents:35 }] },
+  ],
+};
+
+const $ = id => document.getElementById(id);
+const S = window.Singlo;
+let mic = null, exIndex = 0, session = null;
+let ageGroup = S.getProgress().ageGroup || '';
+
+/* ---------- HUD / belt bar ---------- */
+function renderBelt() {
+  const p = S.getProgress();
+  $('hudBelt').textContent = p.belt.emoji;
+  $('hudXP').textContent = p.xp.toLocaleString() + ' XP';
+  $('beltName').textContent = p.belt.emoji + ' ' + p.belt.name;
+  if (p.next) {
+    $('beltNext').textContent = (p.next.xp - p.xp).toLocaleString() + ' XP to ' + p.next.name;
+    $('beltFill').style.width = Math.min(100, ((p.xp - p.belt.xp) / (p.next.xp - p.belt.xp)) * 100) + '%';
+  } else {
+    $('beltNext').textContent = 'Max belt 🖤';
+    $('beltFill').style.width = '100%';
+  }
+}
+renderBelt();
+
+/* ---------- age selection ---------- */
+document.querySelectorAll('.age-card').forEach(el => {
+  if (el.dataset.age === ageGroup) el.classList.add('active');
+  el.addEventListener('click', () => {
+    document.querySelectorAll('.age-card').forEach(a => a.classList.remove('active'));
+    el.classList.add('active');
+    ageGroup = el.dataset.age;
+    S.setPref('ageGroup', ageGroup);
+    exIndex = 0;
+    loadExercise();
+  });
+});
+if (ageGroup) loadExercise();
+
+function loadExercise() {
+  const ex = EXERCISES[ageGroup][exIndex % EXERCISES[ageGroup].length];
+  $('exCard').style.display = 'block';
+  $('exTitle').textContent = ex.title;
+  $('exDesc').textContent = ex.desc;
+  $('targetNote').textContent = ex.chromaOnly ? S.chromaName(ex.steps[0].midi) : S.noteName(ex.steps[0].midi);
+  $('holdFill').style.width = '0%';
+  $('centsLabel').textContent = '';
+  $('status').textContent = "Press start when you're ready.";
+  $('nextEx').style.display = 'none';
+  $('coachBox').classList.remove('show');
+  $('startEx').disabled = false;
+}
+
+/* ---------- exercise engine ---------- */
+async function ensureMic() { if (!mic) mic = await S.startMic(onSample); }
+
+$('hearNote').addEventListener('click', async () => {
+  try { await ensureMic(); } catch(e){ $('status').textContent = 'Allow the microphone to play.'; return; }
+  const ex = EXERCISES[ageGroup][exIndex % EXERCISES[ageGroup].length];
+  const step = session ? session.steps[session.stepIdx] : ex.steps[0];
+  S.playTone(mic.ctx, step.midi, 1.0);
+});
+
+$('startEx').addEventListener('click', async () => {
+  try { await ensureMic(); }
+  catch(e){ $('status').textContent = 'Microphone blocked — allow mic access to play.'; return; }
+  const ex = EXERCISES[ageGroup][exIndex % EXERCISES[ageGroup].length];
+  session = { ex, steps: ex.steps, stepIdx: 0, held: 0, last: performance.now(),
+              samples: 0, hits: 0, centsSum: 0, maxHold: 0, weak: {} };
+  $('startEx').disabled = true;
+  $('status').textContent = 'Listening… sing the note!';
+  showStep();
+});
+
+function showStep() {
+  const st = session.steps[session.stepIdx];
+  $('targetNote').textContent = session.ex.chromaOnly ? S.chromaName(st.midi) : S.noteName(st.midi);
+  $('holdFill').style.width = '0%';
+  session.held = 0;
+}
+
+function onSample(s) {
+  if (!session) { if (!s.silent) $('centsLabel').textContent = s.name; return; }
+  const now = performance.now();
+  const dt = Math.min((now - session.last) / 1000, 0.1);
+  session.last = now;
+  const st = session.steps[session.stepIdx];
+
+  let match = false, dev = null;
+  if (!s.silent) {
+    session.samples++;
+    if (session.ex.chromaOnly) {
+      const targetChroma = ((st.midi % 12) + 12) % 12;
+      if (s.chroma === targetChroma && Math.abs(s.cents) <= st.tolCents) { match = true; dev = s.cents; }
+    } else {
+      dev = Math.round((s.midi - st.midi) * 100);
+      if (Math.abs(dev) <= st.tolCents) match = true;
+    }
+    $('centsLabel').textContent = s.name + (dev !== null ? ` (${dev > 0 ? '+' : ''}${dev}¢)` : '');
+  }
+
+  if (match) {
+    session.hits++; session.centsSum += dev; session.held += dt;
+    session.maxHold = Math.max(session.maxHold, session.held);
+    $('holdFill').style.width = Math.min(100, (session.held / st.holdSec) * 100) + '%';
+    $('status').textContent = 'Locked in — keep holding! 🎯';
+    if (session.held >= st.holdSec) {
+      session.stepIdx++;
+      if (session.stepIdx >= session.steps.length) return finishExercise();
+      $('status').textContent = 'Nice! Next note…';
+      showStep();
+    }
+  } else if (!s.silent) {
+    const key = S.noteName(st.midi);
+    session.weak[key] = (session.weak[key] || 0) + 1;
+    // gentle decay, never a hard reset — kinder for kids & autistic users
+    session.held = Math.max(0, session.held - dt * 0.5);
+    $('holdFill').style.width = Math.min(100, (session.held / st.holdSec) * 100) + '%';
+    $('status').textContent = ageGroup === 'kids' ? 'Almost! Slide your voice a little…' : 'Adjust toward the target…';
+  }
+}
+
+async function finishExercise() {
+  const ex = session.ex;
+  const accuracy = session.samples ? Math.round((session.hits / session.samples) * 100) : 0;
+  const avgCents = session.hits ? Math.round(session.centsSum / session.hits) : 0;
+  const weakNotes = Object.entries(session.weak).sort((a,b)=>b[1]-a[1]).slice(0,2).map(e=>e[0]);
+  const summary = { ageGroup, exercise: ex.title, accuracy, avgCents,
+                    maxHoldSec: Math.round(session.maxHold * 10) / 10, weakNotes };
+  session = null;
+  $('status').textContent = `✅ Complete! +${ex.xp} XP`;
+  $('nextEx').style.display = 'inline-block';
+
+  const result = S.addXP(ex.xp);        // writes to singlo_progress — shared with pitch.html & badges.html
+  renderBelt();
+  if (result.promoted) showPromotion(result.belt);
+
+  $('coachText').textContent = 'thinking…';
+  $('coachBox').classList.add('show');
+  $('coachText').textContent = await SingloCoach.getFeedback(summary);
+}
+
+$('nextEx').addEventListener('click', () => { exIndex++; loadExercise(); });
+
+/* ---------- Part 7: promotion + share card ---------- */
+let currentCard = null;
+function showPromotion(belt) {
+  const p = S.getProgress();
+  currentCard = SingloShare.beltCard({ name: p.name || 'A Singlo singer', belt, xp: p.xp });
+  $('promoTitle').textContent = belt.emoji + ' ' + belt.name + ' Unlocked!';
+  $('promoImg').src = currentCard.dataUrl;
+  $('promoOverlay').classList.add('show');
+}
+$('promoTweet').addEventListener('click', () => currentCard && currentCard.tweet());
+$('promoSave').addEventListener('click', () => currentCard && currentCard.download());
+$('promoClose').addEventListener('click', () => $('promoOverlay').classList.remove('show'));
+
+/* ---------- Part 6: PWA ---------- */
+if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(()=>{});
+</script>
+</body>
+</html>
diff --git a/web/sw.js b/web/sw.js
new file mode 100644
index 0000000..1c66996
--- /dev/null
+++ b/web/sw.js
@@ -0,0 +1,24 @@
+/* Singlo service worker (Part 6) — cache-first app shell */
+const CACHE = 'singlo-v1';
+const ASSETS = [
+  'index.html', 'pitch.html', 'badges.html', 'practice.html', 'battle.html', 'choir.html', 'waves.html', 'voice-painting.html',
+  'js/singlo-core.js', 'js/coach.js', 'js/sharecard.js',
+  'manifest.json', 'icons/icon-192.png', 'icons/icon-512.png',
+];
+self.addEventListener('install', e => {
+  e.waitUntil(caches.open(CACHE).then(c => c.addAll(ASSETS)).catch(()=>{}));
+  self.skipWaiting();
+});
+self.addEventListener('activate', e => {
+  e.waitUntil(caches.keys().then(keys => Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))));
+});
+self.addEventListener('fetch', e => {
+  if (e.request.method !== 'GET') return;
+  e.respondWith(
+    caches.match(e.request).then(hit => hit || fetch(e.request).then(res => {
+      const copy = res.clone();
+      caches.open(CACHE).then(c => c.put(e.request, copy)).catch(()=>{});
+      return res;
+    }).catch(() => caches.match('index.html')))
+  );
+});
