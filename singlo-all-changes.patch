+<script>
+const SERVER_URL = location.hostname === 'localhost' ? 'http://localhost:3001' : 'https://YOUR-APP.fly.dev';
+const socket = io(SERVER_URL);
+const $ = id => document.getElementById(id);
+const S = window.Singlo;
+
+/* night sky */
+for (let i = 0; i < 40; i++) {
+  const st = document.createElement('div');
+  st.className = 'star';
+  st.style.cssText = `left:${Math.random()*100}vw;top:${Math.random()*60}vh;animation-delay:${Math.random()*3}s`;
+  $('stars').appendChild(st);
+}
+$('calmToggle').addEventListener('change', () => document.body.classList.toggle('calm', $('calmToggle').checked));
+
+/* state */
+let mic = null, chord = null, joined = false;
+const singers = new Map(); // id -> element
+let myId = null, lastSent = 0;
+
+socket.on('connect', () => { myId = socket.id; });
+socket.on('online', n => $('onlineCount').textContent = n);
+
+/* join */
+$('joinBtn').addEventListener('click', async () => {
+  try { mic = await S.startMic(onSample); }
+  catch(e){ $('status').textContent = 'Microphone needed to join the fire.'; return; }
+  const p = S.getProgress();
+  const name = $('singerName').value || p.name || 'Singer';
+  S.setPref('name', name);
+  socket.emit('join_choir', { name, belt: p.belt.emoji });
+  joined = true;
+  $('joinBox').style.display = 'none';
+  $('chordCard').style.display = 'block';
+  $('scene').style.display = 'block';
+});
+
+/* my pitch → tone highlight + throttled send */
+let myTone = -1;
+function onSample(s) {
+  if (!joined) return;
+  let tone = -1;
+  if (!s.silent && Math.abs(s.cents) <= 70 && chord) {
+    const ti = chord.tones.indexOf(s.chroma);
+    if (ti >= 0) tone = ti;
+    const now = performance.now();
+    if (now - lastSent > 120) { lastSent = now; socket.emit('choir_pitch', { chroma: s.chroma, cents: s.cents }); }
+  }
+  if (tone !== myTone) {
+    myTone = tone;
+    [0,1,2].forEach(i => $('tone'+i).classList.toggle('mine', i === tone));
+    setSingerTone(myId, tone);
+  }
+}
+
+/* chord cycle */
+socket.on('choir_chord', c => {
+  chord = c;
+  $('chordName').textContent = c.name;
+  c.labels.forEach((l, i) => $('tone'+i).textContent = l);
+  if (mic && !$('calmToggle').checked) {
+    // softly play the chord tones as a guide (root octave 4)
+    c.tones.forEach((t, i) => setTimeout(() => S.playTone(mic.ctx, 60 + ((t - 0 + 12) % 12), 0.7, 0.07), i * 250));
+  }
+});
+
+/* roster → orbs in a circle around the fire */
+socket.on('choir_roster', roster => {
+  const ids = new Set(roster.map(r => r.id));
+  for (const [id, el] of singers) if (!ids.has(id)) { el.remove(); singers.delete(id); }
+  roster.forEach(r => { if (!singers.has(r.id)) addSinger(r); });
+  layoutSingers();
+});
+
+function addSinger(r) {
+  const el = document.createElement('div');
+  el.className = 'singer' + (r.id === myId ? ' me' : '');
+  el.innerHTML = `<div class="orb">${r.belt || '🎤'}</div><div class="nm">${escapeHtml(r.name)}${r.id === myId ? ' (you)' : ''}</div>`;
+  $('scene').appendChild(el);
+  singers.set(r.id, el);
+}
+
+function layoutSingers() {
+  const n = singers.size, R = 42; // % radius around fire center (50%,56%)
+  let i = 0;
+  for (const el of singers.values()) {
+    const a = (i / n) * Math.PI * 2 - Math.PI / 2;
+    el.style.left = (50 + R * Math.cos(a)) + '%';
+    el.style.top  = (56 + R * 0.85 * Math.sin(a)) + '%';
+    i++;
+  }
+}
+
+/* peers' pitches light their orbs */
+socket.on('choir_peer_pitch', ({ id, chroma }) => {
+  if (!chord) return;
+  setSingerTone(id, chord.tones.indexOf(chroma));
+});
+
+const toneTimers = new Map();
+function setSingerTone(id, tone) {
+  const el = singers.get(id);
+  if (!el) return;
+  el.classList.remove('h0','h1','h2');
+  if (tone >= 0) {
+    el.classList.add('h' + tone);
+    clearTimeout(toneTimers.get(id));
+    toneTimers.set(id, setTimeout(() => el.classList.remove('h0','h1','h2'), 1500));
+  }
+}
+
+/* harmony → fire size */
+socket.on('choir_harmony', ({ score, active }) => {
+  const fs = 0.6 + score * 1.1; // 0.6x → 1.7x
+  $('fire').style.setProperty('--fs', fs.toFixed(2));
+  $('harmonyLabel').innerHTML = `<b>${Math.round(score*100)}%</b> in harmony · <span>${active}</span> singing`;
+});
+
+window.addEventListener('beforeunload', () => joined && socket.emit('leave_choir'));
+
+function escapeHtml(s){ const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
+
+if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(()=>{});
+</script>
+</body>
+</html>
