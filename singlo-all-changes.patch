+<script>
+// Point this at your deployed Fly.io server in production
+const SERVER_URL = location.hostname === 'localhost' ? 'http://localhost:3001' : 'https://YOUR-APP.fly.dev';
+const socket = io(SERVER_URL);
+const $ = id => document.getElementById(id);
+const S = window.Singlo;
+
+let mic = null, target = null, tolCents = 50;
+let roundSamples = 0, roundHits = 0, roundActive = false;
+
+async function ensureMic() {
+  if (mic) return;
+  mic = await S.startMic(s => {
+    if (s.silent || target === null) return;
+    const dev = (s.midi - target) * 100;
+    setNeedle('meNeedle', dev);
+    socket.emit('pitch', { dev: Math.round(dev) });
+    if (roundActive) {
+      roundSamples++;
+      if (Math.abs(dev) <= tolCents) roundHits++;
+      const acc = Math.round((roundHits / roundSamples) * 100);
+      $('meAcc').textContent = acc + '%';
+      socket.emit('round_score', { accuracy: acc });
+    }
+  });
+}
+
+function setNeedle(id, dev) {
+  const pct = 50 + Math.max(-50, Math.min(50, dev / 2)); // ±100¢ lane
+  $(id).style.left = pct + '%';
+}
+
+$('quickBtn').addEventListener('click', async () => {
+  try { await ensureMic(); } catch(e){ $('lobbyStatus').textContent = 'Mic access needed to battle.'; return; }
+  const name = $('playerName').value || S.getProgress().name || 'Singer';
+  socket.emit('quick_match', { name });
+  $('lobbyStatus').textContent = '⚡ Searching the world for an opponent…';
+});
+socket.on('queued', () => { $('lobbyStatus').textContent = '⚡ In queue — waiting for another singer…'; });
+socket.on('matched', () => { $('lobbyStatus').textContent = 'Matched! Get ready…'; });
+
+$('createBtn').addEventListener('click', async () => {
+  try { await ensureMic(); } catch(e){ $('lobbyStatus').textContent = 'Mic access needed to battle.'; return; }
+  const name = $('playerName').value || S.getProgress().name || 'Player 1';
+  socket.emit('create_room', { name }, ({ code }) => {
+    $('codeBox').classList.remove('hidden');
+    $('roomCode').textContent = code;
+    $('lobbyStatus').textContent = 'Waiting for opponent…';
+  });
+});
+
+$('joinBtn').addEventListener('click', async () => {
+  try { await ensureMic(); } catch(e){ $('lobbyStatus').textContent = 'Mic access needed to battle.'; return; }
+  const code = $('joinCode').value.trim().toUpperCase();
+  const name = $('playerName').value || S.getProgress().name || 'Player 2';
+  socket.emit('join_room', { code, name }, res => {
+    if (res.error) $('lobbyStatus').textContent = res.error;
+  });
+});
+
+socket.on('players', () => {
+  $('lobby').classList.add('hidden');
+  $('battle').classList.remove('hidden');
+});
+
+socket.on('round_start', ({ round, totalRounds, targetMidi, seconds }) => {
+  target = targetMidi;
+  roundSamples = 0; roundHits = 0; roundActive = true;
+  $('roundLabel').textContent = `Round ${round} / ${totalRounds}`;
+  $('targetNote').textContent = S.noteName(targetMidi);
+  $('winner').textContent = '';
+  $('battleStatus').textContent = 'Sing the note!';
+  if (mic) S.playTone(mic.ctx, targetMidi, 0.8);
+  let t = seconds;
+  $('timer').textContent = t + 's';
+  const iv = setInterval(() => {
+    t--; $('timer').textContent = t > 0 ? t + 's' : '';
+    if (t <= 0) { clearInterval(iv); roundActive = false; }
+  }, 1000);
+});
+
+socket.on('opponent_pitch', ({ dev }) => setNeedle('themNeedle', dev));
+
+socket.on('round_result', ({ scores }) => {
+  $('battleStatus').textContent = 'Round over!';
+  $('scores').innerHTML = scores.map(s => `<span>${s.name}: ${s.total}</span>`).join('');
+});
+
+socket.on('battle_over', ({ winner, scores }) => {
+  roundActive = false;
+  $('scores').innerHTML = scores.map(s => `<span>${s.name}: ${s.total}</span>`).join('');
+  $('winner').textContent = winner ? `🏆 ${winner} wins!` : "🤝 It's a tie!";
+  $('battleStatus').textContent = 'Refresh to battle again.';
+  // battle XP: 30 for the winner, 10 for playing — writes to shared singlo_progress
+  const myName = $('playerName').value || S.getProgress().name;
+  S.addXP(winner && winner === myName ? 30 : 10);
+});
+
+socket.on('opponent_left', () => {
+  roundActive = false;
+  $('battleStatus').textContent = 'Opponent left the room.';
+});
+</script>
+</body>
