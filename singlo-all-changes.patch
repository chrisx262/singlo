+
+<!-- Part 2/7: belt-up + share card -->
+<div class="beltup-overlay" id="promoOverlay">
+  <div class="beltup-card">
+    <div class="beltup-title" id="promoTitle">Belt Unlocked!</div>
+    <img id="promoImg" alt="Your new belt card">
+    <div class="btnrow">
+      <button class="btn-main" id="promoTweet">Share on X</button>
+      <button class="btn-ghost" id="promoSave">Save</button>
+      <button class="btn-ghost" id="promoClose">Keep training</button>
+    </div>
+  </div>
+</div>
+
+<nav class="bottom-nav">
