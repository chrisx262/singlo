+<script src="js/singlo-core.js"></script>
+<script>
+/* chroma: 0=C 2=D 4=E 7=G 9=A — octave-free so kids' and adults' voices both work */
+const REGIONS = [
+  { id:'r-sun',    clip:'cr-sun',    chroma:0, name:'C', top:45,  height:145, dot:'#FFC845', line:'Good morning, sun, you glow so bright,' },
+  { id:'r-cloud',  clip:'cr-cloud',  chroma:2, name:'D', top:48,  height:92,  dot:'#C7DCEC', line:'a cotton cloud floats soft and white,' },
+  { id:'r-tree',   clip:'cr-tree',   chroma:4, name:'E', top:176, height:184, dot:'#66A05B', line:'the tree waves hello with leafy hands,' },
+  { id:'r-house',  clip:'cr-house',  chroma:7, name:'G', top:202, height:156, dot:'#E97F6B', line:'a little house on quiet land,' },
+  { id:'r-meadow', clip:'cr-meadow', chroma:9, name:'A', top:336, height:134, dot:'#93C178', line:'and green grass hums where daisies stand.' },
+];
+const FILL_SECONDS = 3, STABLE_FRAMES = 3, COMPLETE_XP = 40;
+const S = window.Singlo;
+const $ = id => document.getElementById(id);
+
+const state = { mic:null, running:false, progress:REGIONS.map(()=>0), done:REGIONS.map(()=>false),
+                stableChroma:-1, stableCount:0, lastTime:0, keyHeld:null, cur:{chroma:-1,label:'—'} };
+
+/* HUD from shared progress */
+function renderHud(){ const p=S.getProgress(); $('hudBelt').textContent=p.belt.emoji; $('hudXP').textContent=p.xp.toLocaleString()+' XP'; }
+renderHud();
+
+/* poem list */
+REGIONS.forEach((r,i)=>{
+  const li=document.createElement('li'); li.id='line-'+i;
+  li.innerHTML=`<span class="dot" style="background:${r.dot}"></span>${r.line}`;
+  $('poemList').appendChild(li);
+});
+
+$('calmToggle').addEventListener('change',()=>document.body.classList.toggle('calm',$('calmToggle').checked));
+
+/* mic */
+$('startBtn').addEventListener('click', async ()=>{
+  if(state.mic) return;
+  try{
+    state.mic = await S.startMic(onSample);
+    S.attachWaveform(document.getElementById('waveStrip'), state.mic.analyser, { glow: !document.getElementById('calmToggle').checked, lineWidth: 2 });
+    $('startBtn').textContent='🎤 Listening…'; $('startBtn').disabled=true;
+    $('noteHint').textContent='Hum any note and watch the picture.';
+  }catch(e){
+    $('noteHint').textContent='Microphone blocked here — try the number keys below.';
+  }
+  startLoop();
+});
+
+function onSample(s){
+  if(s.silent){ state.cur={chroma:-1,label:state.cur.label}; return; }
+  const tol = $('easyToggle').checked ? 75 : 45;
+  state.cur = { chroma: Math.abs(s.cents)<=tol ? s.chroma : -1, label: S.chromaName(s.nearestMidi) };
+}
+
+function startLoop(){
+  if(state.running) return;
+  state.running=true; state.lastTime=performance.now();
+  requestAnimationFrame(loop);
+}
+
+function loop(now){
+  const dt=Math.min((now-state.lastTime)/1000,0.1); state.lastTime=now;
+
+  let chroma=-1, label='—';
+  if(state.keyHeld!==null){ chroma=REGIONS[state.keyHeld].chroma; label=REGIONS[state.keyHeld].name; }
+  else { chroma=state.cur.chroma; label=state.cur.chroma>=0?state.cur.label:(state.cur.label||'—'); }
+
+  if(chroma===state.stableChroma) state.stableCount++;
+  else { state.stableChroma=chroma; state.stableCount=1; }
+  const stable = state.stableCount>=STABLE_FRAMES ? state.stableChroma : -1;
+
+  $('noteBig').textContent=label;
+
+  let matched=null;
+  REGIONS.forEach((r,i)=>{
+    const g=$(r.id);
+    const active=!state.done[i] && stable===r.chroma;
+    g.classList.toggle('active',active);
+    if(active){
+      matched=r.name;
+      state.progress[i]=Math.min(1,state.progress[i]+dt/FILL_SECONDS);
+      setFill(i,state.progress[i]);
+      if(state.progress[i]>=1) completeRegion(i);
+    }
+  });
+  if(matched) $('noteHint').textContent=`Beautiful — ${matched} is painting! Keep going…`;
+  else if(label!=='—') $('noteHint').textContent='Nice sound. Slide up or down to find a part of the picture.';
+
+  requestAnimationFrame(loop);
+}
+
+function setFill(i,p){
+  const r=REGIONS[i], rect=$(r.clip);
+  rect.setAttribute('y', r.top+(1-p)*r.height);
+  rect.setAttribute('height', p*r.height);
+}
+
+function completeRegion(i){
+  if(state.done[i]) return;
+  state.done[i]=true;
+  $(REGIONS[i].id).classList.remove('active');
+  $(REGIONS[i].id).classList.add('done');
+  $('line-'+i).classList.add('revealed');
+  if(!$('calmToggle').checked && state.mic) S.playTone(state.mic.ctx, 60+REGIONS[i].chroma, 0.5, 0.1);
+  if(state.done.every(Boolean)){
+    $('finishCard').classList.add('show');
+    $('noteHint').textContent='The whole picture is painted. 🌈';
+    S.addXP(COMPLETE_XP);   // shared singlo_progress — counts toward your belt
+    renderHud();
+  }
+}
+
+/* keyboard fallback */
+window.addEventListener('keydown',e=>{
+  const n=parseInt(e.key,10);
+  if(n>=1&&n<=REGIONS.length){ state.keyHeld=n-1; startLoop(); }
+});
+window.addEventListener('keyup',e=>{
+  const n=parseInt(e.key,10);
+  if(n>=1&&n<=REGIONS.length&&state.keyHeld===n-1) state.keyHeld=null;
+});
+
+if('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(()=>{});
+</script>
+</body>
+</html>
