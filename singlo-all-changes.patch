+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Singlo ⚔️ – Pitch Battle</title>
+<link rel="manifest" href="manifest.json">
+<meta name="theme-color" content="#1A1A2E">
+<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
+<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.7.5/socket.io.min.js"></script>
+<style>
+  :root{--pink:#FF4F91;--yellow:#FFD93D;--teal:#00C9A7;--purple:#7B61FF;--dark:#1A1A2E;--card-bg:rgba(255,255,255,0.07);--radius:24px}
+  *{margin:0;padding:0;box-sizing:border-box}
+  body{font-family:'Nunito',sans-serif;background:var(--dark);color:#fff;min-height:100vh;overflow-x:hidden}
+  .bg{position:fixed;inset:0;z-index:0;overflow:hidden}
+  .blob{position:absolute;border-radius:50%;filter:blur(80px);opacity:.25;animation:float 8s ease-in-out infinite}
+  .blob1{width:460px;height:460px;background:var(--pink);top:-120px;left:-120px}
+  .blob2{width:380px;height:380px;background:var(--purple);bottom:-100px;right:-60px;animation-delay:2s}
+  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-30px)}}
+  @media(prefers-reduced-motion:reduce){.blob{animation:none}}
+
+  .wrapper{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:22px 18px 90px}
+  .logo{font-family:'Fredoka One',cursive;font-size:1.4rem;margin-bottom:14px}
+  .logo a{color:#fff;text-decoration:none}
